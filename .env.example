# Copy this file to .env and paste your optional free API keys below.
# Open-Meteo and USGS do not need API keys.
FIRMS_MAP_KEY=put_your_free_nasa_firms_map_key_here

# Gemini powers AI scoring, explanations, and tips.
GEMINI_API_KEY=put_your_free_gemini_api_key_here
# GOOGLE_AI_API_KEY or GOOGLE_API_KEY also work if you already use those names.
GEMINI_MODEL=gemini-2.5-flash

# GNews powers recent news context for Gemini.
GNEWS_API_KEY=put_your_free_gnews_api_key_here
# GNEWS_KEY also works if you already use that name.
GNEWS_LANGUAGE=en
# Optional 2-letter country filter, for example: us, in, gb. Leave blank for any country.
GNEWS_COUNTRY=
GNEWS_MAX_ARTICLES=6

# Optional timeouts in milliseconds.
AI_TIMEOUT_MS=12000
NEWS_TIMEOUT_MS=9000
